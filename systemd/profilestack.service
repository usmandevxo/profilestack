[Unit]
Description=ProfileStack - Anti-Detect Browser Cluster Daemon
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=ubuntu
Group=www
WorkingDirectory=/www/wwwroot/profilestack
Environment="PYTHONPATH="
Environment="PATH=/www/wwwroot/profilestack/.venv/bin:/usr/local/bin:/usr/bin:/bin"
# NOTE: must stay --workers 1 - MCP SSE sessions are stored in-process, so with
# >1 uvicorn worker the SSE GET lands on one worker while message POSTs get
# routed to the other (session not found: intermittent 404s/timeouts on all MCP clients).
ExecStart=/www/wwwroot/profilestack/.venv/bin/uvicorn app.server:app --host 127.0.0.1 --port 7800 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
