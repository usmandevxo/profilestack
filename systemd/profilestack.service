[Unit]
Description=ProfileStack - Anti-Detect Browser Cluster Daemon
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=ubuntu
Group=www
WorkingDirectory=/www/wwwroot/profilestack
Environment="PYTHONPATH="
Environment="PATH=/www/wwwroot/profilestack/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/www/wwwroot/profilestack/.venv/bin/uvicorn app.server:app --host 127.0.0.1 --port 7800 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
